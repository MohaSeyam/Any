<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="التجهيز والترخيص اليدوي للجهاز"
            android:textColor="#0D1B2A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#E0E7FF"
            android:padding="12dp"
            android:textColor="#1E3A8A"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerateSampleDb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#0F766E"
            android:text="1. إنشاء قاعدة بيانات مشفرة تجريبية بالصور والـ PDF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. المفتاح الأولي للجهاز (انقله لأداة إصدار التراخيص):"
            android:textColor="#1B263B"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivRequestQr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:contentDescription="QR طلب التفعيل"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvRequestCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:textIsSelectable="true"
            android:textColor="#334155"
            android:textSize="11sp"
            android:typeface="monospace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyRequest"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="نسخ المفتاح الأولي" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="3. إدخال مفتاح الترخيص الصادر لهذا الجهاز وتفويض المدير:"
            android:textColor="#1B263B"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanLicenseQr"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="مسح مفتاح الترخيص بالكاميرا (QR)" />

        <EditText
            android:id="@+id/etLicenseToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="الصق مفتاح الترخيص الموقّع (LIC2....)"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etAdminPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="كلمة مرور الأدمن الخاصة (طبقة حماية إضافية)"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="4. تعيين حساب المستخدم المربوط بهذا الجهاز (Argon2id):"
            android:textColor="#1B263B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="اسم المستخدم (Username)"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/etUserPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="كلمة مرور المستخدم (6 خانات على الأقل)"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B" />

        <CheckBox
            android:id="@+id/cbSealAdb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="false"
            android:textColor="#0F172A"
            android:text="قفل منفذ ADB نهائياً بعد التفعيل (للإنتاج فقط عند تفعيل Device Owner)" />

        <ProgressBar
            android:id="@+id/progressActivation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvActivationFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B91C1C"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivateDevice"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1D4ED8"
            android:text="تفعيل الجهاز وتشفير الخزنة وبدء العمل"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
